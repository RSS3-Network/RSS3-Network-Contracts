pragma solidity 0.8.20;

import {LibZip} from "@solady/utils/LibZip.sol";

library ChipDetail {
    // class: c
    function getChipDetail(uint256 id) external pure returns (string memory, string memory) {
        uint256 idx = id % 11;
        string[11] memory chipDetailSVGs = [
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex""
        ];
        string[11] memory chipDetailTraits = [
            "Detail 1",
            "Detail 2",
            "Detail 3",
            "Detail 4",
            "Detail 5",
            "Detail 6",
            "Detail 7",
            "Detail 8",
            "Detail 9",
            "Detail 10",
            "Detail 11"
        ];

        bytes memory chipDetail = LibZip.flzCompress(bytes(chipDetailSVGs[idx]));
        return (string(chipDetail), chipDetailTraits[idx]);
    }
}
