pragma solidity 0.8.24;

import {LibZip} from "@solady/utils/LibZip.sol";

library ChipCorners {
    function getAlphaChipCorner() external pure returns (string memory) {
        bytes memory alphaSVG =
            hex"";
        return string(LibZip.flzDecompress(alphaSVG));
    }

    function getPublicGoodChipCorner() external pure returns (string memory) {
        bytes memory publicGoodSVG =
            hex"";
        return string(LibZip.flzDecompress(publicGoodSVG));
    }

    function getChipCorner(uint256 id) external pure returns (string memory, string memory) {
        string[7] memory chipCornersSVGs = [
            hex"",
            hex"",
            hex"163c7061746820643d224d3620366836763648367a4d3838800b01682d200c0336203838e00218800c40190c2220636c6173733d2261222f3e",
            hex"",
            hex"",
            hex"",
            hex""
        ];

        string[7] memory chipCornersTraits =
            ["Corner 1", "Corner 2", "Corner 3", "Corner 4", "Corner 5", "Corner 6", "Corner 7"];

        uint256 idx = id % 7;
        bytes memory chipCornersSVG = LibZip.flzDecompress(bytes(chipCornersSVGs[idx]));
        return (string(chipCornersSVG), chipCornersTraits[idx]);
    }
}
