pragma solidity 0.8.20;

import {LibZip} from "@solady/utils/LibZip.sol";

library ChipDetails {
    function getChipDetail(uint256 id) external pure returns (string memory, string memory) {
        string[11] memory chipDetailsSVGs = [
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex""
        ];

        string[11] memory chipDetailsTraits = [
            "Details 1",
            "Details 2",
            "Details 3",
            "Details 4",
            "Details 5",
            "Details 6",
            "Details 7",
            "Details 8",
            "Details 9",
            "Details 10",
            "Details 11"
        ];

        uint256 idx = id % 11;
        bytes memory chipDetailsSVG = LibZip.flzDecompress(bytes(chipDetailsSVGs[idx]));
        return (string(chipDetailsSVG), chipDetailsTraits[idx]);
    }
}
