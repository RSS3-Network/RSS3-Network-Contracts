pragma solidity 0.8.20;

import {LibZip} from "@solady/utils/LibZip.sol";

library HeadDetails {
    function getHeadDetail(uint256 id) external pure returns (string memory, string memory) {
        string[16] memory headDetailsSVGs = [
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex""
        ];

        string[16] memory headDetailsTraits = [
            "Beret",
            "Brains",
            "Top Hat",
            "Cowboy Hat",
            "Viking",
            "Cyclops",
            "Magic Hat",
            "Mushroom",
            "Bowler Hat",
            "Crown",
            "Hat",
            "Beanie",
            "Rabbit Ears",
            "Tall Ears",
            "Round Ears",
            "Antenna"
        ];

        uint256 idx = id % 16;
        bytes memory headDetailsSVG = LibZip.flzDecompress(bytes(headDetailsSVGs[idx]));
        return (string(headDetailsSVG), headDetailsTraits[idx]);
    }
}
