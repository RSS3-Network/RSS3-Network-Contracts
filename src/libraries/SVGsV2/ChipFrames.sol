pragma solidity 0.8.24;

import {LibZip} from "@solady/utils/LibZip.sol";

library ChipFrames {
    function getChipFrame(uint256 id) external pure returns (string memory, string memory) {
        string[9] memory chipFramesSVGs = [
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex"",
            hex""
        ];

        string[9] memory chipFramesTraits = [
            "Chip 1",
            "Chip 2",
            "Chip 3",
            "Chip 4",
            "Chip 5",
            "Chip 6",
            "Chip 7",
            "Chip 8",
            "Chip 9"
        ];

        uint256 idx = id % 9;
        bytes memory chipFramesSVG = LibZip.flzDecompress(bytes(chipFramesSVGs[idx]));
        return (string(chipFramesSVG), chipFramesTraits[idx]);
    }
}
