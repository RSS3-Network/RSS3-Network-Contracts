pragma solidity 0.8.20;

import {LibZip} from "@solady/utils/LibZip.sol";

library NftCards {
    function getAlphaNftCard() external pure returns (string memory) {
        bytes memory alphaSVG =
            hex"";
        return string(LibZip.flzDecompress(alphaSVG));
    }

    function getPublicGoodNftCard() external pure returns (string memory) {
        bytes memory publicGoodSVG =
            hex"";
        return string(LibZip.flzDecompress(publicGoodSVG));
    }

    function getNftCard(uint256 id) external pure returns (string memory, string memory) {
        string[5] memory nftCardsSVGs = [
            hex"",
            hex"",
            hex"",
            hex"",
            hex""
        ];

        string[5] memory nftCardsTraits = ["Cool White", "Yellow", "Blue", "Red", "Green"];

        uint256 idx = id % 5;
        bytes memory nftCardsSVG = LibZip.flzDecompress(bytes(nftCardsSVGs[idx]));
        return (string(nftCardsSVG), nftCardsTraits[idx]);
    }
}
