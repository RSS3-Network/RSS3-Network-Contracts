pragma solidity 0.8.24;

import {LibZip} from "@solady/utils/LibZip.sol";

library HeadShapes {
    function getHeadShape(uint256 id) external pure returns (string memory, string memory) {
        string[3] memory headShapesSVGs = [
            hex"",
            hex"",
            hex""
        ];

        string[3] memory headShapesTraits = ["Default", "Round", "Square"];

        uint256 idx = id % 3;
        bytes memory headShapesSVG = LibZip.flzDecompress(bytes(headShapesSVGs[idx]));
        return (string(headShapesSVG), headShapesTraits[idx]);
    }
}
